#!/usr/bin/env bash
# EPC M10 inverter terminal HMI — Sparkplug B over MQTT (pure bash, subscribe-only)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "${ROOT}/lib/bash/common.sh"
# shellcheck source=/dev/null
source "${ROOT}/lib/bash/sparkplug.sh"
# shellcheck source=/dev/null
source "${ROOT}/lib/bash/mqtt.sh"
# shellcheck source=/dev/null
source "${ROOT}/lib/bash/screen.sh"
# shellcheck source=/dev/null
source "${ROOT}/lib/bash/demo.sh"
# shellcheck source=/dev/null
source "${ROOT}/lib/bash/app.sh"

parse_args "$@"
app_run
exit $?
